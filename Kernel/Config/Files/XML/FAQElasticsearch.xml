        <Navigation>Frontend::Admin</Navigation>
        <Value>
            <Array>
                <Item>FAQCreate</Item>
                <Item>FAQUpdate</Item>
                <Item>FAQDelete</Item>
            </Array>
        </Value>
    </Setting>
</otobo_config>
